{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/notify.mjs", "user-prompt-submit"],
            "timeoutMs": 10000,
            "statusMessage": "qq-notify 记录任务开始"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/notify.mjs", "stop"],
            "timeoutMs": 15000,
            "statusMessage": "qq-notify 检查任务完成通知"
          }
        ]
      }
    ]
  }
}
